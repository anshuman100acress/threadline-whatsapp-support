# Optional Meta Model API routing for signed WhatsApp messages
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3

# Meta WhatsApp Cloud API. Set all five to enable.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=

# Optional n8n handoff. Set both values to enable.
N8N_HANDOFF_URL=
N8N_HANDOFF_TOKEN=
