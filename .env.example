# Optional model-assisted routing for signed WhatsApp messages
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta WhatsApp Cloud API. Set all five to enable.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=

# Optional n8n handoff. Set both values to enable.
N8N_HANDOFF_URL=
N8N_HANDOFF_TOKEN=
